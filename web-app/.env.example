# ── Kisan360 web app ────────────────────────────────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.

# Backend API base URL. In dev you can leave this empty: vite proxies /api → http://localhost:5000
VITE_API_URL=

# Firebase (client-side login). Optional for the demo — demo-mode auth via
# POST /api/auth/demo-login works without Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
