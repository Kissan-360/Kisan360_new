# ── Kisan360 backend ────────────────────────────────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.

# Port the Express API listens on
PORT=5000

# MongoDB connection string (Atlas or local mongod). The server boots even if
# this is unreachable (features that need the DB will report errors).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kisan360?retryWrites=true&w=majority

# FastAPI service URLs
ML_SERVICE_URL=http://localhost:8000        # disease detection (main.py)
RAG_SERVICE_URL=http://localhost:8001       # RAG advisory (advisory_service.py)
NET_REALIZATION_URL=http://localhost:8002   # net-realization calculator (net_realization.py)

# External API keys
# Agmarknet market-price API (data.gov.in) — live pull; app falls back to the
# stamped cache snapshot when the API is unreachable or the key is missing.
AGMARKNET_API_KEY=
# OpenWeatherMap (weather + notifications)
OPENWEATHER_API_KEY=
# Groq (RAG LLM generation; optional — advisory falls back to templates without it)
GROQ_API_KEY=

# Demo auth (simulated for the demo). Signing secret for demo JWTs issued by
# POST /api/auth/demo-login. In dev, a random secret is generated on boot if
# unset, which invalidates tokens across restarts — set a fixed value locally.
DEMO_JWT_SECRET=

# Optional: Firebase Admin service account (JSON) for production auth.
# When unset, only demo-mode auth is available.
FIREBASE_SERVICE_ACCOUNT_KEY=

# CORS origin for the web app (dev default)
FRONTEND_URL=http://localhost:3000
