{
  "name": "kisan360-mobile-app",
  "version": "1.0.0",
  "description": "Mobile application for Kisan360 agricultural platform",
  "main": "App.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo build",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.18.2",
    "@react-native-picker/picker": "2.5.1",
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/stack": "^6.3.17",
    "axios": "^1.5.0",
    "expo": "~49.0.0",
    "expo-av": "~13.4.0",
    "expo-camera": "~13.4.4",
    "expo-image-picker": "~14.3.2",
    "expo-status-bar": "~1.6.0",
    "firebase": "^10.3.1",
    "react": "18.2.0",
    "react-native": "0.72.4",
    "react-native-safe-area-context": "4.6.3",
    "react-native-screens": "~3.22.0",
    "react-native-toast-message": "^2.1.6"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~18.2.14",
    "@types/react-native": "~0.72.2",
    "jest": "^29.6.2",
    "ts-jest": "^29.1.2",
    "typescript": "^5.1.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "keywords": [
    "agriculture",
    "mobile",
    "react-native",
    "expo"
  ],
  "author": "Kisan360 Team",
  "license": "MIT"
}
